# ─── MQTT Broker ────────────────────────────────────────────────────────────
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_USER=syscloud
MQTT_PASSWORD=change_me_mqtt_password
MQTT_TOPIC_PREFIX=syscloud

# ─── InfluxDB ────────────────────────────────────────────────────────────────
INFLUXDB_PORT=8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=change_me_influx_password
INFLUXDB_ORG=syscloud
INFLUXDB_BUCKET=iot-data
INFLUXDB_TOKEN=change_me_influx_super_secret_token

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana_password

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
JWT_SECRET=change_me_jwt_super_secret_key_32chars_min
CORS_ORIGIN=http://localhost:3000

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ─── Simulator (dev only) ────────────────────────────────────────────────────
SIMULATOR_DEVICE_COUNT=5
SIMULATOR_INTERVAL_MS=5000

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
